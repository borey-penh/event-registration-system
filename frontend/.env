# NOTE: do not hardcode a Cloudflare quick-tunnel URL here - quick tunnels get a
# new random URL every restart and a stale one breaks every login (the SPA keeps
# calling the dead host). The embedded build falls back to its own origin (/api),
# and the dev server proxies /api to localhost:8000.
# VITE_API_URL=https://<stable-domain>/api   # only set for a real custom domain
VITE_PUBLIC_ORIGIN=embedded
